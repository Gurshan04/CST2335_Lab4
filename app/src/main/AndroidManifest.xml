<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="algonquin.cst2335.gurshan">

    <!-- Optional hardware features (marked not required) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Permissions for call and camera (used in your activities) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="ChatRoomApp"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gurshan"
        tools:targetApi="31">

        <!-- ✅ ChatRoom is the launcher activity -->
        <activity
            android:name=".ChatRoom"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity and SecondActivity are still registered -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gurshan" />

        <activity android:name=".SecondActivity" />

    </application>

</manifest>

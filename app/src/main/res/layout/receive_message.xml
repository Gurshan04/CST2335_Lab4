<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Avatar on the left -->
    <ImageView
        android:id="@+id/receiveImage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/receive_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Receiver avatar"
        android:layout_marginEnd="4dp" />

    <!-- Message text -->
    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Message goes here"
        android:textSize="16sp"
        android:background="#FFE5B4"
        android:textColor="#000000"
        android:padding="8dp"
        app:layout_constraintStart_toEndOf="@id/receiveImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Time text -->
    <TextView
        android:id="@+id/time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Time goes here"
        android:textSize="12sp"
        android:textColor="#666"
        app:layout_constraintStart_toEndOf="@id/receiveImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message"
        android:paddingStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
